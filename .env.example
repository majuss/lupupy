# Credentials for testing against a real panel.
#
# Copy this file to .env and fill in your own values:
#
#     cp .env.example .env
#     chmod 600 .env
#
# .env is ignored by git and must never be committed.
# Values already set in the environment take precedence over this file.

LUPUS_USER=your-username
LUPUS_PASSWORD=your-password
LUPUS_IP=192.168.1.10

# Opt-in for the integration test in tests/test_hardware.py.
#
# It arms and disarms a real alarm system, every mode change is reported to
# whatever the panel notifies, and while armed the motion detectors are live,
# so anybody moving in a covered room sets off the siren.
#
# Uncomment only while you want those tests to run:
#
# LUPUS_HARDWARE_TEST=1
